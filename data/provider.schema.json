{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vaibhavs25/free-ai-apis-llm/blob/main/data/provider.schema.json",
  "title": "AI API Atlas dataset",
  "type": "object",
  "required": ["schema_version","directory","last_updated","scope","providers","glossary"],
  "properties": {
    "schema_version": {"type":"string"},
    "directory": {"type":"string"},
    "last_updated": {"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "scope": {"type":"object","required":["includes","excludes"],"properties":{"includes":{"type":"array","items":{"type":"string"}},"excludes":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "providers": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/provider"}},
    "glossary": {"type":"object","additionalProperties":{"type":"string"}}
  },
  "$defs": {
    "provider": {
      "title":"AI API Atlas provider",
      "type":"object",
      "required":["id","name","category","signup_url","docs_url","base_url","auth","account_required","card_required","free_tier_type","free_summary","quota_summary","notable_models","last_verified","verification","sources","status"],
      "properties": {
        "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,63}$"},
        "name":{"type":"string","minLength":2},
        "category":{"enum":["first_party","inference_provider","gateway"]},
        "country":{"type":"string"},
        "country_flag":{"type":"string"},
        "signup_url":{"type":"string","format":"uri"},
        "docs_url":{"type":"string","format":"uri"},
        "pricing_url":{"type":"string","format":"uri"},
        "base_url":{"type":"string","pattern":"^https?://"},
        "auth":{"type":"string"},
        "account_required":{"type":"boolean"},
        "card_required":{"type":["boolean","null"]},
        "identity_verification":{"type":"string"},
        "openai_compatible":{"type":"boolean"},
        "free_tier_type":{"enum":["permanent_free_tier","recurring_free_tier","free_models","free_trial_key","monthly_credit","daily_free_allocation","free_pool","keyless_or_free_token","anonymous_free_tier","self_hosted_free_gateway"]},
        "free_summary":{"type":"string","minLength":10},
        "quota_summary":{"type":"string","minLength":5},
        "privacy_summary":{"type":"string"},
        "region_notes":{"type":"string"},
        "notable_models":{"type":"array","minItems":1,"items":{"type":"object","required":["id","modalities"],"properties":{"id":{"type":"string"},"modalities":{"type":"array","minItems":1,"items":{"type":"string"}},"rate_limit":{"type":"string"}},"additionalProperties":true}},
        "free_routes":{"type":"array","items":{"type":"object","required":["id","description"],"properties":{"id":{"type":"string"},"description":{"type":"string"},"current_limit":{"type":"string"}},"additionalProperties":true}},
        "default_route":{"type":"string"},
        "route_guidance":{"type":"object","additionalProperties":{"type":"string"}},
        "model_selection_url":{"type":"string","format":"uri"},
        "last_verified":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
        "verification":{"type":"string"},
        "sources":{"type":"array","minItems":1,"items":{"type":"string","format":"uri"}},
        "status":{"type":"string"},
        "access_via":{"type":"array","items":{"type":"string"}},
        "direct_api_status":{"type":"string"},
        "endpoint_type":{"enum":["upstream_api","integration_reference","local_gateway"]}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}